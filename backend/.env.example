# =====================================================================
#  MatriAmrit backend - environment
#  NEVER commit this file. It is already listed in backend/.gitignore.
#  Copy .env.example when setting up a new machine or deployment.
# =====================================================================

# ── Runtime ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Comma-separated list of origins allowed to call this API.
# Add your production domain before going live.
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321,http://localhost:5500,https://matriamrit.com,https://www.matriamrit.com

# Set to 1 when running behind a reverse proxy / Vercel / Render / Nginx
# so rate limiting reads the real client IP from X-Forwarded-For.
TRUST_PROXY=0

# ── MongoDB ──────────────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/matriamrit
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/matriamrit?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/matriamrit

# ── Razorpay ─────────────────────────────────────────────────────────
# Dashboard > Account & Settings > API Keys.
# Test keys start with rzp_test_, live keys with rzp_live_.
# RAZORPAY_KEY_ID is the only value ever sent to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Dashboard > Settings > Webhooks > create webhook > set a secret.
# Subscribe to: payment.captured, payment.failed, order.paid, refund.processed
RAZORPAY_WEBHOOK_SECRET=

# ── Commerce rules ───────────────────────────────────────────────────
# All money below is in paise (1 rupee = 100 paise). Integers only.
#
# Delivery is included in the pack price and is NOT shown as a separate
# line anywhere in the UI. Leave both at 0 unless you decide to charge
# for it, in which case the checkout summary needs its delivery row back.
DELIVERY_FEE_PAISE=0
FREE_DELIVERY_ABOVE_PAISE=0
MAX_UNITS_PER_LINE=20
MAX_LINES_PER_ORDER=6
MAX_ORDER_VALUE_PAISE=5000000

# ── Optional: reverse geocoding (Leaflet "pin my location") ──────────
# Nominatim requires an identifying User-Agent with contact details.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=MatriAmrit/1.0 (care@matriamrit.com)

# ── Admin panel ──────────────────────────────────────────────────────
# JWT_SECRET signs admin session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it logs every admin out immediately - that is how you revoke a
# leaked token.
JWT_SECRET=
ADMIN_SESSION_HOURS=8
ADMIN_LOGIN_MAX_ATTEMPTS=6
ADMIN_LOCKOUT_MINUTES=15

# Read ONCE by `npm run seed:admin`, which stores only a bcrypt hash.
# Delete both lines after seeding. Never commit a real password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
